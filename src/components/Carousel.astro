---
// Carousel met vierkante beelden en een 'geeltje' per beeld.
// Alle tekst staat als gewone HTML in de pagina (vertaalbaar en indexeerbaar).
// Zonder JavaScript is dit een horizontaal scrollbare rij (scroll-snap).
import type { Lang } from '../i18n/ui';

interface Props {
  images: { src: string; alt: string; note?: { nl: string; en: string } }[];
  lang: Lang;
  label: string;
}
const { images, lang, label } = Astro.props;
const l = lang === 'nl'
  ? { of: 'van', show: 'Toon beeld' }
  : { of: 'of', show: 'Show image' };
const many = images.length > 1;
---

<div class="carousel" data-carousel role="region" aria-roledescription="carousel" aria-label={label}>
  <ul class="slides" data-slides>
    {
      images.map((img, i) => (
        <li class="slide" aria-roledescription="slide" aria-label={`${i + 1} ${l.of} ${images.length}`}>
          <figure>
            <div class="slide-media">
              <img src={img.src} alt={img.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            </div>
            {img.note && <figcaption class="note">{img.note[lang]}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>
  {
    many && (
      <div class="thumbs" data-thumbs hidden>
        {images.map((img, i) => (
          <button type="button" class="thumb" data-thumb={i} aria-label={`${l.show} ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'}>
            <img src={img.src} alt="" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = root.querySelector<HTMLElement>('[data-slides]');
    const thumbsBox = root.querySelector<HTMLElement>('[data-thumbs]');
    if (!slides) return;
    if (thumbsBox) thumbsBox.hidden = false;
    const thumbs = Array.from(root.querySelectorAll<HTMLElement>('[data-thumb]'));
    const mark = (i: number) => {
      thumbs.forEach((t, k) => t.setAttribute('aria-current', k === i ? 'true' : 'false'));
    };
    const items = Array.from(slides.children) as HTMLElement[];
    let index = 0;
    const go = (i: number) => {
      index = (i + items.length) % items.length;
      slides.scrollTo({ left: items[index].offsetLeft - slides.offsetLeft, behavior: 'smooth' });
      mark(index);
    };
    thumbs.forEach((t, k) => t.addEventListener('click', () => go(k)));
    // Desktop: klik op de linker- of rechterhelft van het beeld = vorige/volgende
    if (items.length > 1 && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const side = (e: MouseEvent) => {
        const r = slides.getBoundingClientRect();
        return e.clientX - r.left < r.width / 2 ? 'left' : 'right';
      };
      slides.addEventListener('mousemove', (e) => { slides.dataset.side = side(e); });
      slides.addEventListener('mouseleave', () => { delete slides.dataset.side; });
      slides.addEventListener('click', (e) => go(side(e) === 'left' ? index - 1 : index + 1));
    }
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(index - 1);
      if (e.key === 'ArrowRight') go(index + 1);
    });
    slides.addEventListener('scroll', () => {
      const i = Math.round(slides.scrollLeft / slides.clientWidth);
      if (i !== index && i >= 0 && i < items.length) {
        index = i;
        mark(i);
      }
    }, { passive: true });
  });
</script>
