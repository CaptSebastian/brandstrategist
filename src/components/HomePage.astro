---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseCard from './CaseCard.astro';
import ShuffleGrid from './ShuffleGrid.astro';
import Contact from './Contact.astro';
import ClientTicker from './ClientTicker.astro';
import { ui, routes, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const r = routes[lang];
const other: Lang = lang === 'nl' ? 'en' : 'nl';

const visible = (await getCollection('cases', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const pinned = visible.filter((e) => e.data.pinned);
const featured = visible.filter((e) => !e.data.pinned);
---

<Base lang={lang} title={t.meta.homeTitle} description={t.meta.homeDesc} path={r.home} alt={routes[other].home}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1>{t.hero.title}</h1>
      <p class="lead">{t.hero.lead}</p>
      <p class="lead">{t.hero.lead2}</p>
      <div class="actions">
        <a class="btn" href={r.contact}>{t.hero.primary}</a>
        <a class="btn ghost" href="#work">{t.hero.secondary}</a>
      </div>
    </div>
  </section>

  <ClientTicker lang={lang} />

  <section class="section" id="change">
    <div class="wrap two-col">
      <h2>{t.change.title}</h2>
      <div class="prose">
        {t.change.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section" id="practice">
    <div class="wrap">
      <h2>{t.practice.title}</h2>
      <p class="lead">{t.practice.intro}</p>
      <ol class="method-list method method-3">
        {
          t.practice.steps.map((step, i) => (
            <li>
              <span class="num">0{i + 1}</span>
              <span class="word">{step.word}</span>
              <p class="q">{step.q}</p>
            </li>
          ))
        }
      </ol>
      <p class="outro">{t.practice.outro}</p>
    </div>
  </section>

  <section class="section" id="method">
    <div class="wrap">
      <h2>{t.method.title}</h2>
      <p class="lead">{t.method.intro}</p>
      <ol class="method-list method">
        {
          t.method.steps.map((step, i) => (
            <li>
              <span class="num">0{i + 1}</span>
              <span class="word">{step.word}</span>
              <p class="q">{step.q}</p>
            </li>
          ))
        }
      </ol>
      <p class="outro">{t.method.outro}</p>
    </div>
  </section>

  <section class="section" id="work">
    <div class="wrap">
      <h2>{t.work.title}</h2>
      {
        pinned.length > 0 && (
          <div class="pinned">
            {pinned.map((entry) => <CaseCard entry={entry} lang={lang} showSummary />)}
          </div>
        )
      }
      {
        featured.length > 0 && (
          <>
            <div class="work-grid">
              <ShuffleGrid count={6}>
                {featured.map((entry) => <CaseCard entry={entry} lang={lang} />)}
              </ShuffleGrid>
            </div>
          </>
        )
      }
      <p class="more"><a class="btn ghost small" href={r.work}>{t.work.all}</a></p>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap two-col">
      <h2>{t.aboutHome.title}</h2>
      <div class="prose">
        {t.aboutHome.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section" id="quotes">
    <div class="wrap">
      <h2>{t.quotes.title}</h2>
      <div class="quotes">
        {
          t.quotes.items.map((q) => (
            <blockquote>
              <p>{q.text}</p>
              <footer>
                {q.name}, {q.org}
              </footer>
            </blockquote>
          ))
        }
      </div>
    </div>
  </section>

  <Contact lang={lang} />
</Base>
