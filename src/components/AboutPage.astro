---
import Base from '../layouts/Base.astro';
import Contact from './Contact.astro';
import { ui, routes, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'nl' ? 'en' : 'nl';
---

<Base lang={lang} title={t.meta.aboutTitle} description={t.meta.aboutDesc} path={routes[lang].about} alt={routes[other].about}>
  <section class="hero">
    <div class="wrap">
      <h1>{t.about.title}</h1>
      <p class="lead">{t.about.intro}</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap two-col">
      <div class="prose">
        {t.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <blockquote>
        <p>{t.about.quote.text}</p>
        <footer>{t.about.quote.name}, {t.about.quote.org}</footer>
      </blockquote>
    </div>
  </section>
  <Contact lang={lang} />
</Base>
