---
import { ui, routes, email, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].contact;
---

<section class="section" id="contact">
  <div class="wrap two-col">
    <div>
      <h2>{t.title}</h2>
      <p class="lead">{t.lead}</p>
      <p>
        {t.orMail}: <a href={`mailto:${email}`}>{email}</a>
      </p>
      <div>
        <strong>{t.visit}</strong>
        <address>
          Meet Berlage<br />
          Oudebrugsteeg 9<br />
          1012 JE Amsterdam
        </address>
      </div>
    </div>
    <!-- Netlify Forms: wordt automatisch opgepikt bij de build -->
    <form name="contact" method="POST" action={routes[lang].thanks} data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="contact" />
      <p class="hp"><label>Don’t fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <div class="field">
        <label for={`name-${lang}`}>{t.name}</label>
        <input id={`name-${lang}`} name="name" type="text" required autocomplete="name" />
      </div>
      <div class="field">
        <label for={`email-${lang}`}>{t.email}</label>
        <input id={`email-${lang}`} name="email" type="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for={`message-${lang}`}>{t.message}</label>
        <textarea id={`message-${lang}`} name="message" rows="5" required></textarea>
      </div>
      <button class="btn" type="submit">{t.send}</button>
    </form>
  </div>
</section>
